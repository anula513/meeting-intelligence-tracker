# Copy this file to .env and fill in your real values.
# .env is gitignored, so your real key never gets committed.

# Your OpenAI API key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-key-here

# Which OpenAI model to use for extraction. Change it here, not in code.
OPENAI_MODEL=your-model-name-here

# Your Pinecone API key (from https://app.pinecone.io).
# The index must be named meeting-tracker (1536 dimensions, cosine).
PINECONE_API_KEY=your-pinecone-key-here
